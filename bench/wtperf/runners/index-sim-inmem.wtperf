# wtperf options file: medium btree configuration
conn_config="cache_size=4G,checkpoint=(wait=5)"
table_config="type=file,leaf_page_max=32k"
table_count=5
key_sz=12
value_sz=4
random_range=100m
pareto=10
scramble=true
icount=0
report_interval=5
run_time=120
populate_threads=1
threads=((count=4,inserts=1))
